PORT=3000
SESSION_SECRET=change_this_for_development
NODE_ENV=development

# ---- Internet deployment (docs/DEPLOYMENT_INTERNET_V0.md) ----
# Production refuses to start unless SESSION_SECRET is a real secret (>= 32 chars) and KAHE_TRUST_PROXY is set.
# KAHE_TRUST_PROXY=off        # direct / LAN: no reverse proxy, X-Forwarded-* ignored (the default when unset)
# KAHE_TRUST_PROXY=1          # one reverse proxy hop in front (Nginx on the same host)
# KAHE_TRUST_PROXY=loopback   # or a list of proxy addresses / CIDRs: "10.0.0.5, 172.16.0.0/12"
# KAHE_COOKIE_SECURE=true     # development only; production always sets Secure (HTTPS required)
# KAHE_TW_UPLOAD_DIR=/srv/kahe360/private/talent-registration   # private candidate uploads (default: ./uploads/talent-registration)

# ---- PostgreSQL (DB-M1) — placeholders only; never commit real credentials ----
# Runtime connection: the LEAST-PRIVILEGE application role (DML only).
DATABASE_URL=postgresql://kahe360_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5432/kahe360
# Migration connection: the schema-owner role (DDL). Used only by `npm run db:migrate`.
DATABASE_MIGRATION_URL=postgresql://kahe360_owner:CHANGE_ME_OWNER_PASSWORD@127.0.0.1:5432/kahe360
# Role that receives the runtime grants after migrating.
KAHE_DB_APP_ROLE=kahe360_app

# Connection pool (defaults shown). Size for the DATABASE SERVER, not the laptop:
# total across all app processes must stay well below PostgreSQL max_connections.
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
KAHE_DB_LOCK_TIMEOUT_MS=5000
# 0 = disabled. Recommended in production (e.g. 30000).
KAHE_DB_STATEMENT_TIMEOUT_MS=0
# Production: require TLS.
# DATABASE_SSL=true

# ---- development helpers only ----
# `npm run db:bootstrap` creates the two roles + the database (UTF8, LC_COLLATE 'C').
# DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME_ADMIN_PASSWORD@127.0.0.1:5432/postgres
# KAHE_DB_NAME=kahe360
# KAHE_DB_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
# KAHE_DB_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
# Tests create and drop their own `kahe360_test_*` databases through this URL.
# They never use DATABASE_URL.
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME_ADMIN_PASSWORD@127.0.0.1:5432/postgres
