{
  "name": "kahe360-internal",
  "version": "0.2.0",
  "description": "KAHE 360 Internal Operations Portal (PostgreSQL)",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node database/seed.js",
    "test:phase0": "node tests/phase0.test.js",
    "test:phase1a": "node tests/phase1a.test.js",
    "test:phase1b": "node tests/phase1b.test.js",
    "test:phase0b": "node tests/phase0b.test.js",
    "test:phase2a": "node tests/phase2a.test.js",
    "test:phase2b": "node tests/phase2b.test.js",
    "test:phase2c": "node tests/phase2c.test.js",
    "test:phase2d": "node tests/phase2d.test.js",
    "test:phase2e": "node tests/phase2e.test.js",
    "test:phase2f": "node tests/phase2f.test.js",
    "test:phase2g": "node tests/phase2g.test.js",
    "test:phase2h": "node tests/phase2h.test.js",
    "test:e2e": "node tests/e2e.test.js",
    "test:all": "for t in phase0 phase0b phase1a phase1b phase2a phase2b phase2c phase2d phase2e phase2f phase2g phase2h e2e; do node tests/$t.test.js || exit 1; done",
    "migrate:phase2i": "node database/migrate-phase2i.js",
    "test:phase2i": "node tests/phase2i.test.js",
    "test:phase3a": "node tests/phase3a.test.js",
    "test:phase3b": "node tests/phase3b.test.js",
    "test:payroll-regression": "node scripts/test-payroll-regression.js",
    "check:payroll-freeze": "node scripts/check-payroll-freeze.js",
    "baseline:payroll-freeze": "node scripts/check-payroll-freeze.js --baseline",
    "migrate:attendance-a1": "node database/migrate-attendance-a1.js",
    "test:attendance": "node tests/attendance-a1.test.js && node tests/attendance-a2.test.js && node tests/attendance-a3.test.js",
    "migrate:attendance-a2": "node database/migrate-attendance-a2.js",
    "test:attendance-a2": "node tests/attendance-a2.test.js",
    "migrate:attendance-a3": "node database/migrate-attendance-a3.js",
    "test:attendance-a3": "node tests/attendance-a3.test.js",
    "test:attendance-a4": "node tests/attendance-a4-cp1.test.js",
    "test:attendance-a4-cp2": "node tests/attendance-a4-cp2.test.js",
    "db:bootstrap": "node database/pg/bootstrap.js",
    "db:migrate": "node database/pg/migrate.js",
    "db:status": "node database/pg/migrate.js status",
    "test:dbm1": "node tests/dbm1-foundation.test.js && node tests/dbm1-datamigration.test.js && node tests/dbm1-cp5.test.js && node tests/dbm1-cp6.test.js",
    "check:payroll-pure": "node scripts/check-payroll-pure-formulas.js",
    "legacy-sqlite:migrate:phase0": "node database/legacy-sqlite/migrate-phase0.js",
    "legacy-sqlite:migrate:phase0b": "node database/legacy-sqlite/migrate-phase0b.js",
    "legacy-sqlite:migrate:phase1a": "node database/legacy-sqlite/migrate-phase1a.js",
    "legacy-sqlite:migrate:phase1b": "node database/legacy-sqlite/migrate-phase1b.js",
    "legacy-sqlite:migrate:phase2a": "node database/legacy-sqlite/migrate-phase2a.js",
    "legacy-sqlite:migrate:phase3b": "node database/legacy-sqlite/migrate-phase3b.js",
    "db:migrate-from-sqlite": "node database/pg/migrate-from-sqlite.js",
    "db:smoke-migrated": "node tools/dbm1/smoke-migrated.js",
    "test:dbm1-datamigration": "node tests/dbm1-datamigration.test.js",
    "test:dbm1-cp5": "node tests/dbm1-cp5.test.js",
    "test:dbm1-cp6": "node tests/dbm1-cp6.test.js",
    "db:verify-backup": "node tools/dbm1/verify-backup-restore.js",
    "db:migrate-talent": "node database/pg/talent/migrate-talent.js",
    "db:status-talent": "node database/pg/talent/migrate-talent.js status",
    "seed:talent": "node database/seed-talent.js",
    "test:talent-cp1": "node tests/talent-cp1.test.js",
    "test:talent-registration-v0": "node tests/talent-registration-v0.test.js",
    "test:talent-hardening-v0": "node tests/talent-hardening-v0.test.js",
    "db:verify-backup-talent": "node tools/talent/verify-backup-restore.js",
    "test:everything": "npm run check:payroll-freeze && npm run check:payroll-pure && npm run test:dbm1 && npm run test:attendance && npm run test:attendance-a4 && npm run test:attendance-a4-cp2 && npm run test:payroll-regression"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5"
  }
}
